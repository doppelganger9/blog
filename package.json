{
  "name": "david-blog",
  "private": true,
  "description": "David Lacourt's personal blog, powered by SvelteKit and Markdown",
  "version": "3.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "author": "David Lacourt <david.lacourt@gmail.com>",
  "bugs": {
    "url": "https://github.com/doppelganger9/blog/issues"
  },
  "homepage": "https://github.com/doppelganger9/blog#readme",
  "keywords": [
    "svelte",
    "sapper",
    "markdown",
    "blog",
    "javascript",
    "html",
    "css",
    "e2e",
    "jamstack"
  ],
  "license": "MIT",
  "main": "n/a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doppelganger9/blog.git"
  },
  "scripts": {
    "postinstall": "svelte-kit sync && npx patch-package && cd lambda && npm install",
    "dev": "vite dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "build": "run-p build:*",
    "build:app": "vite build",
    "preview": "vite preview",
    "serve": "http-server build -s -p 8080",
    "start": "run-p start:*",
    "start:app": "npm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:coverage": "COVERAGE=true playwright test",
    "start:lambda": "cd lambda && npm start",
    "migration:check": "npm run build && npm run test"
  },
  "devDependencies": {
    "@akebifiky/remark-simple-plantuml": "1.0.2",
    "@playwright/test": "1.63.0",
    "@remark-embedder/core": "3.0.3",
    "@remark-embedder/transformer-oembed": "5.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "elizabot": "0.0.3",
    "http-server": "14.1.1",
    "mdsvex": "0.12.8",
    "monocart-coverage-reports": "3.2.0",
    "npm-run-all2": "8.0.4",
    "patch-package": "8.0.1",
    "prism-svelte": "0.5.0",
    "prismjs": "1.30.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-figure": "1.0.1",
    "rehype-slug": "6.0.0",
    "rehype-urls": "1.2.0",
    "remark-abbr": "1.4.2",
    "remark-twemoji": "0.1.1",
    "rxjs": "7.8.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tslib": "2.8.1",
    "twemoji": "14.0.2",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@extractus/oembed-extractor": "4.1.0",
    "marked": "16.4.2",
    "plantuml-encoder": "1.4.0",
    "pusher-js": "8.6.0",
    "tonal": "6.4.3",
    "tone": "15.1.22",
    "vexflow": "5.0.0"
  }
}
